{
  "name": "elixir-cloud-components",
  "version": "2.0.0-alpha.50",
  "description": "Cloud Components are lightweight, fast and reusable web components by the ELIXIR On-Cloud community for managing and accessing various services.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elixir-cloud-aai/cloud-components.git"
  },
  "prettier": {
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2
  },
  "bugs": {
    "url": "https://github.com/elixir-cloud-aai/cloud-components/issues"
  },
  "homepage": "https://github.com/elixir-cloud-aai/cloud-components#readme",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint:fix  && prettier .",
    "new": "turbo gen",
    "prepare": "husky install",
    "test": "turbo run test --parallel",
    "test:watch": "turbo run test --watch"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.9.0",
    "@elixir-cloud/eslint-config": "*",
    "@lit/react": "^1.0.2",
    "@open-wc/eslint-config": "^12.0.3",
    "@open-wc/testing": "^4.0.0",
    "@turbo/gen": "^2.11.10",
    "@web/dev-server": "^0.4.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "commander": "^12.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^7.32.0",
    "fast-glob": "^3.3.2",
    "globby": "^14.0.1",
    "husky": "^8.0.0",
    "playwright": "^1.56.1",
    "prettier": "^2.8.8",
    "sinon": "^17.0.1",
    "tsup": "^8.0.2",
    "turbo": "^2.11.10",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.6.1"
  },
  "packageManager": "npm@9.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "clipboardy": {
      "cross-spawn": "^6.0.6"
    },
    "katex": "^0.18.2",
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
