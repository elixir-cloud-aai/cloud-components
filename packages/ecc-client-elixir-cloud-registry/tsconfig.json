{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "lib": ["es2017", "dom"],
    "strict": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "outDir": "dist",
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@elixir-cloud/service-registry/components/*": [
        "../../node_modules/@elixir-cloud/service-registry/dist/components/*"
      ],
      "@elixir-cloud/service-registry/events": [
        "../../node_modules/@elixir-cloud/service-registry/dist/events/index"
      ]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
