{
  "name": "ecc-mock-server",
  "private": true,
  "description": "Mock backend for the live previews of the Cloud Components documentation",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch-path=src --watch-path=fixtures src/main.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@elixir-cloud/eslint-config": "*",
    "@types/node": "^22.12.0",
    "eslint": "^8.57.0",
    "typescript": "*"
  }
}
